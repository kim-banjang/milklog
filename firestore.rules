rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ── users/{uid} : 본인 문서만 ──
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── invites/{code} : 합류용 코드→babyId 매핑 ──
    // 로그인 사용자는 코드 조회 가능(babyId만 노출), 생성 가능, 수정/삭제 불가
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
      allow list: if false;
    }

    // ── babies/{babyId} ──
    match /babies/{babyId} {
      function baby() { return resource.data; }
      function isMember() { return signedIn() && request.auth.uid in baby().members; }
      function isOwner()  { return signedIn() && request.auth.uid == baby().ownerUid; }

      // 알람 필드만 변경됐는지
      function onlyAlarmChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['intervalMin', 'nextAt', 'alarmActive']);
      }
      // 초대코드로 합류: 기존 멤버가 아니면서 본인을 members에 추가, members/memberInfo만 변경
      function isJoining() {
        return signedIn()
          && !(request.auth.uid in baby().members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo']);
      }

      allow read: if isMember();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      // owner: 전체 수정 / member: 알람 필드만 / 합류: 본인 추가
      allow update: if isOwner()
        || (isMember() && onlyAlarmChanged())
        || isJoining();

      allow delete: if isOwner();

      // ── feeds 서브컬렉션 ──
      match /feeds/{feedId} {
        function parentMembers() {
          return get(/databases/$(database)/documents/babies/$(babyId)).data.members;
        }
        function parentOwner() {
          return get(/databases/$(database)/documents/babies/$(babyId)).data.ownerUid;
        }
        function isParentMember() { return signedIn() && request.auth.uid in parentMembers(); }

        allow read: if isParentMember();

        // 본인 uid로만 기록 생성
        allow create: if isParentMember()
          && request.resource.data.recordedBy == request.auth.uid;

        // 본인 기록만 수정/삭제 (owner는 타인 기록도 가능)
        allow update, delete: if isParentMember()
          && (resource.data.recordedBy == request.auth.uid
              || request.auth.uid == parentOwner());
      }
    }
  }
}
